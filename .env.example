PORT=3000
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Секрет для подписи JWT (обязателен в production)
JWT_SECRET="change-me"
# Client ID приложения Google OAuth. Пустой — кнопка входа через Google
# отвечает 501: секрет для проверки id_token не нужен, хватает client_id.
GOOGLE_CLIENT_ID=""
