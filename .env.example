PORT=3000
# База. ВАЖНО при развернутом сервере: держи здесь ОТДЕЛЬНУЮ ветку Neon,
# а не ту, на которой работает production. Игровой цикл живет в памяти
# процесса, и локальный `npm run dev` на боевой базе дает второй тик поверх
# первого — два процесса начнут затирать состояние друг друга сбросами.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Секрет для подписи JWT (обязателен в production)
JWT_SECRET="change-me"
# Отдавать код смены пароля прямо в ответе API. Только для стенда: роут
# открытый, и с этим флагом любой, кто знает чужой email, заберет аккаунт.
# В production игнорируется при любом значении.
AUTH_EXPOSE_RESET_TOKEN="false"
# Client ID приложения Google OAuth. Пустой — кнопка входа через Google
# отвечает 501: секрет для проверки id_token не нужен, хватает client_id.
GOOGLE_CLIENT_ID=""
# Токен бота Telegram: им подписан initData мини-приложения, и им же он
# проверяется. Это СЕКРЕТ, в отличие от GOOGLE_CLIENT_ID: клиенту он никогда
# не отдается. Пустой — вход через Telegram отвечает 501.
TELEGRAM_BOT_TOKEN=""
# Ключ Gemini для ботов: https://aistudio.google.com/apikey
# Пустой — боты играют по статичным характерам, ИИ просто выключен.
GEMINI_API_KEY=""
# Идентификаторы моделей Google меняет часто, поэтому модель — переменная.
GEMINI_MODEL="gemini-3.5-flash-lite"
