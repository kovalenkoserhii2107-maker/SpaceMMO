// Space Strategy MMO — Prisma schema
// ЭТАП 1: User, SolarSystem, Planet, Base.
// ЭТАП 2: Research, ResearchJob, BuildJob, Ship, ShipJob.
// ЭТАП 3: Fleet (полеты флота), PlanetScan (туман войны).
// ЭТАП 4: TradeHub, HubStorage, MarketOrder, Trade + баланс криптогривны.
// ЭТАП 5: Defense, DefenseJob, BattleReport, WarDeclaration.
// ЭТАП 6: макро-координаты систем, аномалии, антиматерия и межзвездные прыжки.
// ЭТАП 7: экспедиции в глубокий космос и PvE-события.
// ЭТАП 8: User отвечает только за авторизацию, игровая личность вынесена
// в Commander, добавлены достижения.
// ЭТАП 9: синдикаты, общий банк, заявки на вступление и войны альянсов.
// ЭТАП 10: новые классы кораблей под систему типов урона.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Учетная запись: отвечает только за вход в игру (Этап 8).
/// Игровая личность вынесена в Commander.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  authProvider AuthProvider @default(LOCAL)
  /// Идентификатор пользователя у внешнего провайдера (Google/Apple/Facebook).
  providerId   String?
  /// Хеш пароля для локальных аккаунтов; у OAuth-аккаунтов пуст.
  passwordHash String?

  /// Права доступа. Роль живет на учетной записи, а не на командире:
  /// это свойство доступа к серверу, а не игровой роли в мире.
  role UserRole @default(USER)

  /// Одноразовый токен смены пароля.
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  /// Когда аккаунт заблокирован гейм-мастером. null — доступ открыт.
  /// Дата, а не флаг: важно не только «закрыт», но и когда это случилось.
  blockedAt DateTime?

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  commander Commander?

  @@unique([authProvider, providerId])
  @@map("users")
}

/// Командир — игровая личность. Все базы, флоты и ресурсы принадлежат ему.
model Commander {
  id       String @id @default(cuid())
  userId   String @unique
  nickname String @unique
  /// Идентификатор аватара из набора заглушек.
  avatarId String @default("nova")

  /// Криптогривна — валюта командира.
  credits Float @default(1000)

  /// Счетчики боев для профиля.
  battlesWon  Int @default(0)
  battlesLost Int @default(0)

  /// Членство в синдикате.
  syndicateId       String?
  /// Прежняя роль. Устарела вместе с появлением рангов и читается только затем,
  /// чтобы разложить по стартовым рангам тех, кто вступил до них.
  syndicateRole     SyndicateRole?
  syndicateRankId   String?
  syndicateJoinedAt DateTime?
  /// Когда командир сам вышел из синдиката — от этого считается пауза перед новым.
  syndicateLeftAt   DateTime?
  /// Заслуги в текущем синдикате: взносы и налог. При вступлении обнуляются.
  syndicateMerit    Int            @default(0)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  syndicate        Syndicate?              @relation("SyndicateMembers", fields: [syndicateId], references: [id], onDelete: SetNull)
  syndicateRank    SyndicateRank?          @relation("SyndicateRankMembers", fields: [syndicateRankId], references: [id], onDelete: SetNull)
  codexVersions    SyndicateCodexVersion[] @relation("SyndicateCodexAuthor")
  syndicateActions SyndicateTransaction[]  @relation("SyndicateTxActor")
  leadingSyndicate Syndicate?              @relation("SyndicateLeader")
  applications     SyndicateApplication[]  @relation("ApplicationAuthor")
  reviewed         SyndicateApplication[]  @relation("ApplicationReviewer")
  bankOperations   SyndicateTransaction[]
  bases            Base[]
  researches       Research[]
  researchJob      ResearchJob?
  researchHelpers  ResearchHelper[]
  fleets           Fleet[]
  fleetTemplates   FleetTemplate[]
  inbox            Message[]               @relation("MessageRecipient")
  sentMessages     Message[]               @relation("MessageSender")
  scans            PlanetScan[]
  hubStorages      HubStorage[]
  hubAccount       HubAccount?
  orders           MarketOrder[]
  barterOffers     BarterOffer[]
  purchases        Trade[]                 @relation("TradeBuyer")
  sales            Trade[]                 @relation("TradeSeller")
  expeditions      ExpeditionReport[]
  attacksMade      BattleReport[]          @relation("BattleAttacker")
  attacksTaken     BattleReport[]          @relation("BattleDefender")
  warsStarted      WarDeclaration[]        @relation("WarAggressor")
  warsAgainst      WarDeclaration[]        @relation("WarTarget")
  achievements     CommanderAchievement[]
  bot              Bot?

  @@map("commanders")
}

/// Синдикат — объединение командиров с общим банком и дипломатией.
/// Бот-командир: тот же командир, что и живой игрок, но решения за него
/// принимает планировщик. Своей экономики у бота нет — он ходит теми же
/// методами Game Loop, поэтому платит те же цены и ждет те же таймеры.
model Bot {
  id          String       @id @default(cuid())
  commanderId String       @unique
  character   BotCharacter

  /// Пауза без удаления: бот остается в мире, но перестает принимать решения.
  active Boolean @default(true)

  /// Когда планировщику будить бота в следующий раз. Хранится в БД, а не в
  /// памяти: перезапуск сервера не должен обнулять расписание и заставлять
  /// всех ботов ходить одновременно.
  nextDecisionAt DateTime @default(now())

  /// Долгоживущие цели: какую планету бот наметил под колонию, кого выбрал
  /// жертвой. Решение принимается за секунды, а исполняется за часы полета,
  /// поэтому намерение переживает отдельный вызов планировщика.
  memory Json @default("{}")

  /// Что бот сделал последним — для админки, чтобы было видно, что он живой.
  lastAction   String?
  lastActionAt DateTime?

  createdAt DateTime @default(now())

  commander Commander @relation(fields: [commanderId], references: [id], onDelete: Cascade)

  @@map("bots")
}

/// Характер задает цель бота и то, куда он тратит доход.
enum BotCharacter {
  /// Колонизация всего космоса: экспансия и война.
  AGGRESSOR
  /// Капитал и неприступность: биржа, добыча, плотная оборона.
  TRADER
}

model Syndicate {
  id       String @id @default(cuid())
  name     String @unique
  /// Короткий тег для отображения рядом с позывным.
  tag      String @unique
  leaderId String @unique

  createdAt DateTime @default(now())

  /// Правила набора: открыт, по заявке или закрыт.
  recruitment SyndicateRecruitment @default(APPLICATION)
  /// Минимальный счет рейтинга, с которым можно вступить.
  minScore    Int                  @default(0)
  /// Вступительный взнос в казну, криптогривна.
  entryFee    Int                  @default(0)

  /// Налог с крипто-фермы участников, в процентах.
  taxRate        Int       @default(0)
  /// Новая ставка вступает в силу не сразу: участник должен успеть узнать о ней.
  pendingTaxRate Int?
  taxEffectiveAt DateTime?

  /// Кіш — хаб синдиката. Система заполняется при первом обращении у синдикатов,
  /// основанных до его появления: у них ее просто нет.
  kishSystemId   String?
  kishLevel      Int       @default(1)
  /// Когда Кіш переносили в последний раз: переносить можно не чаще раза в сутки.
  kishMovedAt    DateTime?
  /// «Дозор» — модуль Коша: видно вооруженные флоты, летящие к участникам.
  /// Ноль — не построен.
  watchLevel     Int       @default(0)
  /// «Академія» — модуль Коша; уровень — потолок уровня любой технологии синдиката.
  academyLevel   Int       @default(0)
  /// «Скарбниця» — модуль Коша: чем выше уровень, тем больше казны не унести налетом.
  treasuryLevel  Int       @default(0)
  /// Осколки у Коша: разбитый здесь флот оставляет поле, как у планеты.
  debrisOre      Float     @default(0)
  debrisPolymers Float     @default(0)

  /// Счетчики рейтингов синдиката. Копятся в момент события, а не выводятся
  /// из текущего состава: бой и взнос засчитываются тому синдикату, в котором
  /// участник состоял тогда, и новичок не приносит с собой чужую историю.
  /// Стоимость флота противника, уничтоженного участниками.
  destroyedValue   Float @default(0)
  /// Взносы, вступительные и налог — все, что участники отдали в казну.
  contributedValue Float @default(0)
  /// Вложено из казны в Кіш и его модули.
  investedValue    Float @default(0)

  leader       Commander               @relation("SyndicateLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members      Commander[]             @relation("SyndicateMembers")
  kishSystem   SolarSystem?            @relation("SyndicateKish", fields: [kishSystemId], references: [id], onDelete: SetNull)
  ranks        SyndicateRank[]
  codex        SyndicateCodexVersion[]
  kishFleets   Fleet[]                 @relation("KishFleets")
  technologies SyndicateTechnology[]
  research     SyndicateResearch?
  gates        SyndicateGate[]
  defenses     SyndicateDefense[]
  bank         SyndicateBank?
  applications SyndicateApplication[]
  transactions SyndicateTransaction[]
  warsStarted  SyndicateWar[]          @relation("SyndicateWarAggressor")
  warsAgainst  SyndicateWar[]          @relation("SyndicateWarTarget")

  @@map("syndicates")
}

/// Общий счет синдиката: пополняется пожертвованиями участников.
model SyndicateBank {
  id          String @id @default(cuid())
  syndicateId String @unique
  credits     Float  @default(0)
  /// Ресурсная казна Коша. Привозят и вывозят ее флотом — логистика
  /// остается частью игры, а не кнопкой «перевести».
  ore         Float  @default(0)
  polymers    Float  @default(0)
  plasma      Float  @default(0)
  /// Антиматерия казны — на перенос Коша через Браму.
  antimatter  Float  @default(0)

  syndicate Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)

  @@map("syndicate_banks")
}

/// Журнал операций банка: видно, кто сколько внес.
model SyndicateTransaction {
  id          String          @id @default(cuid())
  syndicateId String
  commanderId String?
  kind        SyndicateTxKind
  amount      Float
  comment     String?
  /// Кто совершил операцию, если это не сам участник строки: при выдаче
  /// из казны получатель — `commanderId`, выдавший — `actorId`.
  actorId     String?
  /// Ресурсы операции. `amount` у ресурсных операций — сумма единиц:
  /// по нему считается общий с гривной дневной лимит выдачи.
  ore         Float           @default(0)
  polymers    Float           @default(0)
  plasma      Float           @default(0)
  antimatter  Float           @default(0)
  createdAt   DateTime        @default(now())

  syndicate Syndicate  @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  commander Commander? @relation(fields: [commanderId], references: [id], onDelete: SetNull)
  actor     Commander? @relation("SyndicateTxActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([syndicateId, createdAt])
  @@map("syndicate_transactions")
}

/// Заявка на вступление. Одобряет лидер или офицер.
/// Ранг синдиката: название, место в иерархии и права.
/// Место (`position`) решает, кто над кем: ноль — вершина, действовать
/// можно только на тех, чей ранг ниже своего.
model SyndicateRank {
  id                 String                @id @default(cuid())
  syndicateId        String
  name               String
  position           Int
  permissions        SyndicatePermission[]
  /// Сколько криптогривны обладатель ранга может выдать из казны за сутки.
  dailyWithdrawLimit Int                   @default(0)
  createdAt          DateTime              @default(now())

  syndicate Syndicate   @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  members   Commander[] @relation("SyndicateRankMembers")

  @@unique([syndicateId, name])
  @@map("syndicate_ranks")
}

/// Версия кодекса. Текущая — последняя; прежние хранятся, чтобы было видно,
/// на каких условиях вступал каждый.
model SyndicateCodexVersion {
  id          String   @id @default(cuid())
  syndicateId String
  text        String
  authorId    String?
  createdAt   DateTime @default(now())

  syndicate Syndicate  @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  author    Commander? @relation("SyndicateCodexAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([syndicateId, createdAt])
  @@map("syndicate_codex_versions")
}

/// Налог участника за сутки. Без внешних ключей намеренно: пишется в сбросе
/// тика, и исчезнувший между кешем и записью синдикат не должен ронять
/// всю транзакцию сохранения.
model SyndicateTaxLedger {
  id          String   @id @default(cuid())
  syndicateId String
  commanderId String
  day         DateTime @db.Date
  amount      Int      @default(0)

  @@unique([syndicateId, commanderId, day])
  @@map("syndicate_tax_ledger")
}

model SyndicateApplication {
  id             String            @id @default(cuid())
  syndicateId    String
  commanderId    String
  status         ApplicationStatus @default(PENDING)
  /// Версия кодекса, которую кандидат принял, подавая заявку.
  codexVersionId String?

  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  syndicate  Syndicate  @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  commander  Commander  @relation("ApplicationAuthor", fields: [commanderId], references: [id], onDelete: Cascade)
  resolvedBy Commander? @relation("ApplicationReviewer", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([syndicateId, commanderId])
  @@map("syndicate_applications")
}

/// Война между синдикатами. Объявляют лидеры и офицеры.
model SyndicateWar {
  id           String   @id @default(cuid())
  aggressorId  String
  targetId     String
  declaredById String?
  declaredAt   DateTime @default(now())

  aggressor Syndicate @relation("SyndicateWarAggressor", fields: [aggressorId], references: [id], onDelete: Cascade)
  target    Syndicate @relation("SyndicateWarTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([aggressorId, targetId])
  @@map("syndicate_wars")
}

enum SyndicateRole {
  LEADER
  OFFICER
  MEMBER
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SyndicateTxKind {
  DONATION
  FOUNDING
  PAYOUT
  TAX
  ENTRY_FEE
  KISH_UPGRADE
  WATCH_UPGRADE
  RESOURCE_DELIVERY
  RESOURCE_PICKUP
  ACADEMY_UPGRADE
  SYNDICATE_RESEARCH
  GATE_BUILD
  KISH_MOVE
  TREASURY_UPGRADE
  KISH_DEFENSE
  KISH_RAIDED
}

enum SyndicatePermission {
  APPLICATIONS
  KICK
  PROMOTE
  BROADCAST
  WITHDRAW
  TAX
  CODEX
  RULES
  DIPLOMACY
  KISH
  ACADEMY
}

enum SyndicateRecruitment {
  OPEN
  APPLICATION
  CLOSED
}

/// Каталог достижений. Наполняется при старте сервера.
model Achievement {
  id          String @id @default(cuid())
  /// Стабильный код, по которому движок выдает награду.
  code        String @unique
  title       String
  description String
  icon        String @default("★")

  commanders CommanderAchievement[]

  @@map("achievements")
}

/// Выданное достижение.
model CommanderAchievement {
  id            String   @id @default(cuid())
  commanderId   String
  achievementId String
  unlockedAt    DateTime @default(now())

  commander   Commander   @relation(fields: [commanderId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([commanderId, achievementId])
  @@map("commander_achievements")
}

enum UserRole {
  USER
  ADMIN
  /// Учетная запись бота: игрового входа в нее нет ни паролем, ни через Google.
  BOT
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
  FACEBOOK
  TELEGRAM
}

/// Звездная система — макро-объект галактической карты.
model SolarSystem {
  id        String        @id @default(cuid())
  name      String        @unique
  /// Координаты в галактике (макро-карта).
  galaxyX   Int
  galaxyY   Int
  /// Класс звезды влияет на выработку энергии планет системы.
  starClass StarClass
  /// Аномалия в центре системы. Черная дыра искажает время во всей системе.
  anomaly   SystemAnomaly @default(NONE)
  createdAt DateTime      @default(now())

  planets        Planet[]
  kishes         Syndicate[]        @relation("SyndicateKish")
  syndicateGates SyndicateGate[]
  hub            TradeHub?
  fleets         Fleet[]
  expeditions    ExpeditionReport[]

  @@unique([galaxyX, galaxyY])
  @@map("solar_systems")
}

/// Планета/спутник внутри системы. Коэффициенты богатства задают скорость добычи.
model Planet {
  id       String     @id @default(cuid())
  name     String
  systemId String
  /// Позиция (орбита) внутри системы: 1..N.
  position Int
  type     PlanetType
  /// Количество слотов под здания.
  size     Int

  /// Коэффициенты богатства (множители базовой добычи).
  oreRichness        Float
  polymersRichness   Float
  plasmaRichness     Float
  /// Коэффициент инсоляции — множитель выработки солнечных электростанций.
  energyRichness     Float
  /// Насыщенность экзотическими частицами — множитель синтеза антиматерии.
  antimatterRichness Float @default(1)

  /// Поле обломков на орбите: остатки уничтоженных флотов и обороны.
  /// Хранится на планете, а не отдельной таблицей: поле есть у каждой орбиты
  /// и живет ровно столько же, сколько сама планета.
  debrisOre      Float @default(0)
  debrisPolymers Float @default(0)

  system        SolarSystem    @relation(fields: [systemId], references: [id], onDelete: Cascade)
  base          Base?
  scans         PlanetScan[]
  fleetsFrom    Fleet[]        @relation("FleetOrigin")
  fleetsTo      Fleet[]        @relation("FleetTarget")
  battleReports BattleReport[]

  @@unique([systemId, position])
  @@index([systemId])
  @@map("planets")
}

/// База игрока на планете: склад ресурсов и уровни инфраструктуры.
model Base {
  id          String @id @default(cuid())
  name        String
  commanderId String
  planetId    String @unique

  /// Склад ресурсов (дробные значения — начисление идет каждую секунду).
  /// Стартовый запас щедрый намеренно: первый час игрок должен строить,
  /// а не ждать, пока накопится на первую шахту.
  ore        Float @default(1500)
  polymers   Float @default(800)
  plasma     Float @default(400)
  /// Антиматерия — топливо межзвездных прыжков.
  antimatter Float @default(0)

  /// Уровни инфраструктуры добычи и энергетики (Этап 1).
  oreMineLevel       Int @default(0)
  polymerPlantLevel  Int @default(0)
  plasmaReactorLevel Int @default(0)
  powerPlantLevel    Int @default(0)

  /// Инфраструктура Этапа 2.
  scienceCenterLevel Int @default(0)
  shipyardLevel      Int @default(0)

  /// Инфраструктура Этапа 6.
  antimatterFactoryLevel Int @default(0)

  /// Склад ресурсов: общий лимит на руду, полимеры и плазму.
  cryptoFarmLevel     Int @default(0)
  oreStorageLevel     Int @default(0)
  polymerStorageLevel Int @default(0)
  plasmaStorageLevel  Int @default(0)

  /// Время последнего начисления ресурсов тиком (для догона офлайн-периода).
  lastTickAt DateTime @default(now())
  createdAt  DateTime @default(now())

  commander    Commander       @relation(fields: [commanderId], references: [id], onDelete: Cascade)
  planet       Planet          @relation(fields: [planetId], references: [id], onDelete: Cascade)
  fleets       Fleet[]
  buildJob     BuildJob?
  researchHelp ResearchHelper?
  shipJobs     ShipJob[]
  ships        Ship[]
  defenses     Defense[]
  defenseJobs  DefenseJob[]
  researchJob  ResearchJob?

  @@index([commanderId])
  @@map("bases")
}

/// Стройка здания на базе. Одновременно активна не больше одной на базу.
model BuildJob {
  id          String       @id @default(cuid())
  baseId      String       @unique
  building    BuildingType
  targetLevel Int
  startedAt   DateTime     @default(now())
  finishesAt  DateTime

  base Base @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@map("build_jobs")
}

/// Изученные технологии игрока (общие для всех его баз).
model Research {
  id          String         @id @default(cuid())
  commanderId String
  tech        TechnologyType
  level       Int            @default(0)

  commander Commander @relation(fields: [commanderId], references: [id], onDelete: Cascade)

  @@unique([commanderId, tech])
  @@map("researches")
}

/// Активное исследование игрока. Одновременно активно не больше одного.
model ResearchJob {
  id          String         @id @default(cuid())
  commanderId String         @unique
  /// Лаборатория, с которой запущено исследование (с нее списаны ресурсы).
  baseId      String         @unique
  tech        TechnologyType
  targetLevel Int
  startedAt   DateTime       @default(now())
  finishesAt  DateTime
  /// Уровень ведущей лаборатории на момент запуска. Срок считался по нему,
  /// и пересчет при присоединении помощника должен исходить из него же,
  /// а не из нынешнего уровня. У заданий старше помощников поля нет.
  labLevel    Int?

  commander Commander @relation(fields: [commanderId], references: [id], onDelete: Cascade)
  base      Base      @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@map("research_jobs")
}

/// Лаборатория другой колонии, присоединившаяся к идущему исследованию.
/// Привязана к командиру, а не к заданию: задание переписывается при каждом
/// сбросе удалением и созданием, и помощники пишутся тем же способом рядом.
model ResearchHelper {
  id           String   @id @default(cuid())
  commanderId  String
  baseId       String   @unique
  /// Уровень лаборатории на момент присоединения: вклад фиксируется им.
  labLevel     Int
  /// Уплачено за присоединение — возвращается этой же базе при отмене.
  ore          Int
  polymers     Int
  plasma       Int
  /// Сколько секунд срезано: из них восстанавливается полный срок исследования,
  /// от которого меряется доля следующей помощницы.
  savedSeconds Int
  joinedAt     DateTime @default(now())

  commander Commander @relation(fields: [commanderId], references: [id], onDelete: Cascade)
  base      Base      @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@index([commanderId])
  @@map("research_helpers")
}

/// Корабли, стоящие на базе. Перемещение флота — Этап 3.
model Ship {
  id     String   @id @default(cuid())
  baseId String
  type   ShipType
  count  Int      @default(0)

  base Base @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@unique([baseId, type])
  @@map("ships")
}

/// Стационарная оборона планеты. Летать не может, гибнет в бою безвозвратно.
model Defense {
  id     String      @id @default(cuid())
  baseId String
  type   DefenseType
  count  Int         @default(0)

  base Base @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@unique([baseId, type])
  @@map("defenses")
}

/// Очередь постройки обороны на верфи — устроена так же, как очередь кораблей.
model DefenseJob {
  id          String      @id @default(cuid())
  baseId      String
  type        DefenseType
  remaining   Int
  quantity    Int
  unitSeconds Float
  nextUnitAt  DateTime
  createdAt   DateTime    @default(now())

  base Base @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@index([baseId, createdAt])
  @@map("defense_jobs")
}

/// Отчет о бое: доступен обеим сторонам, состав и потери лежат в data.
model BattleReport {
  id         String       @id @default(cuid())
  attackerId String
  defenderId String
  planetId   String
  winner     BattleWinner

  plunderOre      Float @default(0)
  plunderPolymers Float @default(0)
  plunderPlasma   Float @default(0)

  data      Json
  createdAt DateTime @default(now())

  attacker Commander @relation("BattleAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defender Commander @relation("BattleDefender", fields: [defenderId], references: [id], onDelete: Cascade)
  planet   Planet    @relation(fields: [planetId], references: [id], onDelete: Cascade)

  @@index([attackerId, createdAt])
  @@index([defenderId, createdAt])
  @@map("battle_reports")
}

/// Отчет об экспедиции в глубокий космос: что нашли или кого встретили.
model ExpeditionReport {
  id          String            @id @default(cuid())
  commanderId String
  systemId    String
  outcome     ExpeditionOutcome

  /// Найденное за вылет.
  lootOre        Float @default(0)
  lootPolymers   Float @default(0)
  lootAntimatter Float @default(0)

  /// Человекочитаемый итог и подробности события.
  summary   String
  data      Json
  createdAt DateTime @default(now())

  commander Commander   @relation(fields: [commanderId], references: [id], onDelete: Cascade)
  system    SolarSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([commanderId, createdAt])
  @@map("expedition_reports")
}

/// Объявление войны. Атака возможна только при активной войне между игроками.
model WarDeclaration {
  id          String   @id @default(cuid())
  aggressorId String
  targetId    String
  declaredAt  DateTime @default(now())

  aggressor Commander @relation("WarAggressor", fields: [aggressorId], references: [id], onDelete: Cascade)
  target    Commander @relation("WarTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([aggressorId, targetId])
  @@map("war_declarations")
}

enum DefenseType {
  CANNON
  LASER
  GAUSS
  PLASMA
  SUPER_WEAPON
}

enum BattleWinner {
  ATTACKER
  DEFENDER
}

/// Заказ на верфи. Очередь обрабатывается по порядку создания, корабли выходят поштучно.
model ShipJob {
  id          String   @id @default(cuid())
  baseId      String
  type        ShipType
  /// Сколько кораблей осталось построить по этому заказу.
  remaining   Int
  /// Изначальный объем заказа (для отображения прогресса).
  quantity    Int
  /// Длительность постройки одного корабля в секундах на момент заказа.
  unitSeconds Float
  /// Время выхода следующего корабля. Тикает только у первого заказа в очереди.
  nextUnitAt  DateTime
  createdAt   DateTime @default(now())

  base Base @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@index([baseId, createdAt])
  @@map("ship_jobs")
}

/// Полет флота между планетами. Время в пути и возврат считает Game Loop.
model Fleet {
  id                String  @id @default(cuid())
  commanderId       String
  /// База отправления — туда вернется флот и оттуда списано топливо.
  originBaseId      String
  originPlanetId    String
  /// Цель полета: планета или торговый хаб (заполнено ровно одно поле).
  targetPlanetId    String?
  targetHubId       String?
  /// Цель экспедиции: глубокий космос указанной системы.
  targetSystemId    String?
  /// Рейс в Кіш синдиката. Кіш не планета: место определяет синдикат,
  /// а при роспуске в пути ссылка обнуляется и груз летит домой.
  targetSyndicateId String?

  mission FleetMission
  status  FleetStatus  @default(OUTBOUND)

  /// Состав флота.
  probes        Int @default(0)
  smallCargo    Int @default(0)
  largeCargo    Int @default(0)
  lightFighters Int @default(0)
  heavyFighters Int @default(0)
  cruisers      Int @default(0)
  frigates      Int @default(0)
  bombers       Int @default(0)
  battleships   Int @default(0)
  carriers      Int @default(0)
  recyclers     Int @default(0)
  colonyShips   Int @default(0)

  /// Груз на борту: руда, полимеры и плазма занимают трюмы.
  cargoOre        Float @default(0)
  cargoPolymers   Float @default(0)
  cargoPlasma     Float @default(0)
  /// Антиматерия, найденная в экспедиции, едет домой в баках и трюмы не занимает.
  cargoAntimatter Float @default(0)

  /// Сколько запрошено к вывозу с хаба (для миссии HUB_PICKUP).
  pickupOre      Float @default(0)
  pickupPolymers Float @default(0)
  pickupPlasma   Float @default(0)

  /// Сожженная плазма за весь маршрут (списана при отправке).
  fuelSpent       Float
  /// Сожженная антиматерия — только для межзвездных прыжков.
  antimatterSpent Float     @default(0)
  /// Прыжок между системами, а не полет внутри одной.
  interstellar    Boolean   @default(false)
  /// Рейс без возврата: флот остается в точке назначения.
  /// У колонизации и дислокации это свойство самой миссии, а транспорт
  /// летит и туда-обратно, и в один конец — поэтому признак хранится.
  oneWay          Boolean   @default(false)
  /// Прыжок через Браму: по нему считается пропускная способность врат.
  viaGate         Boolean   @default(false)
  /// Удержание: сколько секунд стоять у союзника и до какого момента.
  holdSeconds     Int       @default(0)
  holdUntil       DateTime?
  /// Расстояние в орбитах и скорость флота — для отображения.
  distance        Int
  speed           Float

  departedAt DateTime
  arrivesAt  DateTime
  returnsAt  DateTime
  createdAt  DateTime @default(now())

  commander       Commander    @relation(fields: [commanderId], references: [id], onDelete: Cascade)
  originBase      Base         @relation(fields: [originBaseId], references: [id], onDelete: Cascade)
  targetSyndicate Syndicate?   @relation("KishFleets", fields: [targetSyndicateId], references: [id], onDelete: SetNull)
  originPlanet    Planet       @relation("FleetOrigin", fields: [originPlanetId], references: [id], onDelete: Cascade)
  targetPlanet    Planet?      @relation("FleetTarget", fields: [targetPlanetId], references: [id], onDelete: Cascade)
  targetHub       TradeHub?    @relation(fields: [targetHubId], references: [id], onDelete: Cascade)
  targetSystem    SolarSystem? @relation(fields: [targetSystemId], references: [id], onDelete: Cascade)

  @@index([status, arrivesAt])
  @@index([status, returnsAt])
  @@index([commanderId])
  @@map("fleets")
}

/// Письмо в центре связи: и личная переписка, и системные отчеты.
model Message {
  id String @id @default(cuid())

  /// Отправитель. null — системное письмо от «Центра связи».
  senderId    String?
  recipientId String

  type    MessageType
  subject String
  body    String
  /// Структурные данные отчета: состав сторон, потери, добыча.
  payload Json?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  sender    Commander? @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient Commander  @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  /// Ящик открывается «сначала новые», непрочитанные считаются отдельным запросом.
  @@index([recipientId, createdAt])
  @@index([recipientId, isRead])
  @@map("messages")
}

enum MessageType {
  /// Личное письмо от другого командира.
  PLAYER
  /// Рассылка лидера по синдикату.
  SYNDICATE
  BATTLE_REPORT
  SPY_REPORT
  EXPEDITION
  /// Логистика: доставка груза, дислокация, возвращение флота с добычей.
  FLEET
  /// Письмо от гейм-мастера: отправитель системный, но это не автоотчет.
  ADMIN
}

/// Сохраненный состав флота: пресет для быстрой отправки.
model FleetTemplate {
  id          String @id @default(cuid())
  commanderId String
  name        String

  probes        Int @default(0)
  smallCargo    Int @default(0)
  largeCargo    Int @default(0)
  lightFighters Int @default(0)
  heavyFighters Int @default(0)
  cruisers      Int @default(0)
  frigates      Int @default(0)
  bombers       Int @default(0)
  battleships   Int @default(0)
  carriers      Int @default(0)
  recyclers     Int @default(0)
  colonyShips   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commander Commander @relation(fields: [commanderId], references: [id], onDelete: Cascade)

  @@unique([commanderId, name])
  @@index([commanderId])
  @@map("fleet_templates")
}

/// Результат сканирования планеты зондом — основа «тумана войны».
model PlanetScan {
  id          String   @id @default(cuid())
  commanderId String
  planetId    String
  scannedAt   DateTime @default(now())
  /// Снимок данных планеты на момент сканирования.
  data        Json

  commander Commander @relation(fields: [commanderId], references: [id], onDelete: Cascade)
  planet    Planet    @relation(fields: [planetId], references: [id], onDelete: Cascade)

  @@unique([commanderId, planetId])
  @@map("planet_scans")
}

/// Нейтральная орбитальная станция у звезды — центр торговли системы.
model TradeHub {
  id       String @id @default(cuid())
  systemId String @unique
  name     String
  /// Позиция станции: 0 — орбита у самой звезды.
  position Int    @default(0)

  system   SolarSystem   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  storages HubStorage[]
  orders   MarketOrder[]
  barters  BarterOffer[]
  trades   Trade[]
  fleets   Fleet[]

  @@map("trade_hubs")
}

/// Личный торговый склад игрока на хабе. Товар сюда привозят транспортом.
model HubStorage {
  id          String @id @default(cuid())
  commanderId String
  hubId       String

  ore      Float @default(0)
  polymers Float @default(0)
  /// Устарел: размер склада теперь один на командира (`HubAccount`). Читается
  /// только затем, чтобы перенести уровень при первом обращении.
  level    Int   @default(1)

  commander Commander @relation(fields: [commanderId], references: [id], onDelete: Cascade)
  hub       TradeHub  @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@unique([commanderId, hubId])
  @@map("hub_storages")
}

/// Ордер в биржевом стакане. Товар (продажа) или криптогривна (покупка) блокируются при выставлении.
model MarketOrder {
  id          String @id @default(cuid())
  hubId       String
  /// Сколько товара взято в залог со склада хаба; остальное — с общего склада.
  /// По ней отмена возвращает товар туда, откуда он ушел. Пусто у заявок,
  /// выставленных до общего склада: те целиком со склада хаба.
  localPart   Float?
  commanderId String

  side         OrderSide
  resource     TradeResource
  /// Цена за единицу в криптогривне.
  pricePerUnit Float
  /// Изначальный объем и остаток (ордер исполняется частями).
  quantity     Float
  remaining    Float

  createdAt DateTime @default(now())

  hub       TradeHub  @relation(fields: [hubId], references: [id], onDelete: Cascade)
  commander Commander @relation(fields: [commanderId], references: [id], onDelete: Cascade)

  @@index([hubId, resource, side, pricePerUnit])
  @@map("market_orders")
}

/// Журнал сделок — история биржи.
/// Бартерное предложение: ресурс за ресурс, без криптогривны.
///
/// Нужен затем, что деньги в игре дефицитны по устройству, а обменять избыток
/// полимеров на нужную руду хочется и без них. Берется целиком: дробить обмен
/// незачем, а частичное исполнение усложнило бы расчет вдвое ради удобства,
/// которое всегда достигается вторым предложением.
model BarterOffer {
  id          String @id @default(cuid())
  commanderId String
  hubId       String
  /// Сколько товара взято в залог со склада хаба; остальное — с общего склада.
  /// По ней отмена возвращает товар туда, откуда он ушел. Пусто у заявок,
  /// выставленных до общего склада: те целиком со склада хаба.
  localPart   Float?

  /// Что отдаю: товар лежит в залоге на складе хаба, как и у обычной продажи.
  giveResource TradeResource
  giveQuantity Float
  /// Что хочу взамен.
  wantResource TradeResource
  wantQuantity Float

  createdAt DateTime @default(now())

  commander Commander @relation(fields: [commanderId], references: [id], onDelete: Cascade)
  hub       TradeHub  @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@index([hubId, createdAt])
  @@map("barter_offers")
}

model Trade {
  id       String @id @default(cuid())
  hubId    String
  buyerId  String
  sellerId String

  resource     TradeResource
  quantity     Float
  pricePerUnit Float
  total        Float

  createdAt DateTime @default(now())

  hub    TradeHub  @relation(fields: [hubId], references: [id], onDelete: Cascade)
  buyer  Commander @relation("TradeBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller Commander @relation("TradeSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([hubId, createdAt])
  @@map("trades")
}

enum OrderSide {
  BUY
  SELL
}

enum TradeResource {
  ORE
  POLYMERS
}

enum FleetMission {
  TRANSPORT
  SCAN
  HUB_DELIVERY
  HUB_PICKUP
  ATTACK
  DEPLOY
  EXPEDITION
  HARVEST
  COLONIZE
  KISH_DELIVERY
  KISH_PICKUP
  HOLD
  KISH_RAID
}

enum ExpeditionOutcome {
  SILENCE
  RESOURCES
  PIRATES_WON
  PIRATES_LOST
  EVADED
}

enum FleetStatus {
  OUTBOUND
  RETURNING
  /// Стоит на орбите союзника и защищает его до конца срока.
  HOLDING
}

enum BuildingType {
  ORE_MINE
  POLYMER_PLANT
  PLASMA_REACTOR
  POWER_PLANT
  SCIENCE_CENTER
  SHIPYARD
  ANTIMATTER_FACTORY
  /// Склады раздельные: у каждого ресурса свой лимит и свой уровень.
  /// Общий лимит создавал тупик — обильный ресурс вытеснял дефицитный,
  /// добыча вставала совсем, и выбраться из этого было нечем.
  ORE_STORAGE
  POLYMER_STORAGE
  PLASMA_STORAGE
  /// Ферма майнинга криптогривны: единственная постройка, которая производит
  /// не ресурс, а деньги. Без нее денежная масса не растет вместе с экономикой.
  CRYPTO_FARM
}

enum TechnologyType {
  /// Криптоинженерия: поднимает отдачу ферм майнинга.
  CRYPTO_TECH
  ENERGY_TECH
  COMPUTING_TECH
  WEAPONS_TECH
  SHIELDS_TECH
  ARMOR_TECH
  MINING_TECH
  COMBUSTION_DRIVE
  HYPERSPACE_PHYSICS
  HYPERDRIVE
  ASTROPHYSICS
  ROBOTICS
  /// Бункерование: поднимает несгораемую долю склада.
  VAULT_TECH
  /// Шпионаж: открывает в разведданных то, что скрыто от простого зонда.
  ESPIONAGE
  TIME_COMPRESSION
}

enum ShipType {
  PROBE
  SMALL_CARGO
  LARGE_CARGO
  LIGHT_FIGHTER
  HEAVY_FIGHTER
  CRUISER
  FRIGATE
  BOMBER
  BATTLESHIP
  CARRIER
  RECYCLER
  COLONY_SHIP
}

enum SystemAnomaly {
  NONE
  BLACK_HOLE
}

enum StarClass {
  BLUE
  WHITE
  YELLOW
  ORANGE
  RED
}

enum PlanetType {
  ROCKY
  OCEANIC
  DESERT
  ICE
  GAS_GIANT
  VOLCANIC
  TOXIC
}

/// Технологии синдиката: действуют на участников, пробывших в нем двое суток.
enum SyndicateTechType {
  MINING
  CONSTRUCTION
  CARGO
  TRADE
  VAULT
  COUNTERINTEL
}

model SyndicateTechnology {
  id          String            @id @default(cuid())
  syndicateId String
  tech        SyndicateTechType
  level       Int               @default(0)

  syndicate Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)

  @@unique([syndicateId, tech])
  @@map("syndicate_technologies")
}

/// Идущее изучение синдиката: одно за раз. Завершается лениво — по сроку,
/// при первом обращении, а не тиком: тик синдикаты в памяти не держит.
model SyndicateResearch {
  id          String            @id @default(cuid())
  syndicateId String            @unique
  tech        SyndicateTechType
  targetLevel Int
  startedAt   DateTime          @default(now())
  finishesAt  DateTime

  syndicate Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)

  @@map("syndicate_research")
}

/// Торговый счет командира на бирже. Размер склада один на все: частные
/// склады всех хабов и общий склад вместе. Общий склад держит купленное
/// и полученное обменом — его можно забрать с любого хаба; привезенное
/// флотом лежит на складе конкретного хаба и забирается только там.
model HubAccount {
  id          String @id @default(cuid())
  commanderId String @unique
  level       Int    @default(1)
  ore         Float  @default(0)
  polymers    Float  @default(0)

  commander Commander @relation(fields: [commanderId], references: [id], onDelete: Cascade)

  @@map("hub_accounts")
}

/// Брама — врата синдиката в системе. Между системами со своими Брамами флот
/// прыгает без «Гипердвигателя» и за треть антиматерии. Ставится только там,
/// где есть колония хотя бы одного участника.
model SyndicateGate {
  id              String   @id @default(cuid())
  syndicateId     String
  systemId        String
  level           Int      @default(1)
  /// Часовое окно пропускной способности: открывается первым прыжком
  /// и держится час. Резервируется при вылете одним условным UPDATE.
  windowStartedAt DateTime @default(now())
  windowShips     Int      @default(0)
  createdAt       DateTime @default(now())

  syndicate Syndicate   @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  system    SolarSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([syndicateId, systemId])
  @@map("syndicate_gates")
}

/// Оборона Коша: установки, купленные из казны. В бою восстанавливаются
/// так же, как оборона колонии.
model SyndicateDefense {
  id          String      @id @default(cuid())
  syndicateId String
  type        DefenseType
  count       Int         @default(0)

  syndicate Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)

  @@unique([syndicateId, type])
  @@map("syndicate_defenses")
}
